# Seeding
# ---------------------------------------------------------------------------


async def seed_server(
    url: str,
    token: str,
    count: int,
    timeout: float,
    other_email: str | None,
) -> dict[str, Any]:
    state: dict[str, Any] = {
        "artifacts_by_token": defaultdict(list),
        "comments_by_token": defaultdict(list),
        "seeded_artifact_ids": [],
        "other_email": other_email or SEED_EMAIL,
    }

    headers = _headers_for_token(token)

    print(f"Seeding: creating {count} artifacts ... ", end="", flush=True)

    async with httpx.AsyncClient(headers=headers, timeout=httpx.Timeout(timeout), follow_redirects=True) as client:
        init_data, init_headers = await mcp_request(client, url, "initialize", {
            "protocolVersion": "2024-11-05",
            "capabilities": {},
            "clientInfo": {"name": "renderdesk-loadtest-seed", "version": "1.0"},
        })
        if "error" in init_data:
            print(f"seed init failed: {init_data['error']}")
            sys.exit(1)
        session_id = init_headers.get("mcp-session-id")
        if session_id:
            client.headers["mcp-session-id"] = session_id
        await mcp_notification(client, url, "notifications/initialized")

        for i in range(count):
            fmt = random.choice(["html", "markdown", "code"])
            if fmt == "code":
                args = {
                    "content": f"print('artifact {i}')\n",
                    "format": "code",
                    "language": "python",
                    "title": f"seed-{i}",
                }
            else:
                args = {
                    "content": f"<h1>Seed {i}</h1>" if fmt == "html" else f"# Seed {i}\n\nBody.\n",
                    "format": fmt,
                    "title": f"seed-{i}",
                }
            resp_data, _resp_headers = await mcp_request(
                client, url, "tools/call", {"name": "publish_artifact", "arguments": args}
            )
            if "error" not in resp_data:
                try:
                    result = _parse_mcp_result(resp_data)
                    if isinstance(result, dict) and "artifact_id" in result:
                        state["artifacts_by_token"][0].append(result["artifact_id"])
                        state["seeded_artifact_ids"].append(result["artifact_id"])
                except Exception:
                    pass

            if (i + 1) % 50 == 0:
                print(f"{i + 1}...", end="", flush=True)

    print(f" done ({len(state['artifacts_by_token'][0])} created)")

    if len(state["artifacts_by_token"][0]) > 0:
        print("Seeding: creating comment threads ... ", end="", flush=True)
        async with httpx.AsyncClient(headers=headers, timeout=httpx.Timeout(timeout), follow_redirects=True) as client:
            init_data, init_headers = await mcp_request(client, url, "initialize", {
                "protocolVersion": "2024-11-05",
                "capabilities": {},
                "clientInfo": {"name": "renderdesk-loadtest-seed", "version": "1.0"},
            })
            session_id = init_headers.get("mcp-session-id")
            if session_id:
                client.headers["mcp-session-id"] = session_id
            await mcp_notification(client, url, "notifications/initialized")

            for aid in state["artifacts_by_token"][0][:10]:
                resp_data, _resp_headers = await mcp_request(client, url, "tools/call", {
                    "name": "reply_to_comment",
                    "arguments": {
                        "comment_id": aid,
                        "body": f"Seed comment on {aid[:8]}",
                    },
                })
                if "error" not in resp_data:
                    try:
                        result = _parse_mcp_result(resp_data)
                        if isinstance(result, dict) and "comment_id" in result:
                            state["comments_by_token"][0].append(result["comment_id"])
                    except Exception:
                        pass
            print(f" done ({len(state['comments_by_token'][0])} threads)")

    return state


# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------


def print_report(phases: list[PhaseResult]) -> None:
    print("=" * 72)
    print("LOAD TEST SUMMARY")
    print("=" * 72)
    for phase in phases:
        print()
        print(f"--- {phase.name} (concurrency={phase.concurrency_level}) ---")
        phase.print_summary()

    # Cross-phase comparison table
    print()
    print("--- Comparison ---")
    print(f"{'Phase':<20s} {'Conc':>5s} {'Toks':>5s} {'Calls':>7s} {'Err%':>6s} "
          f"{'TPS':>8s} {'p50(ms)':>8s} {'p95(ms)':>8s} {'p99(ms)':>8s}")
    print("-" * 76)
    for phase in phases:
        s = phase.summary()
        lat = s.get("latency_ms") or {}
        p50 = f'{lat["p50"]:>8.1f}' if "p50" in lat else f"{'-':>8s}"
        p95 = f'{lat["p95"]:>8.1f}' if "p95" in lat else f"{'-':>8s}"
        p99 = f'{lat["p99"]:>8.1f}' if "p99" in lat else f"{'-':>8s}"
        print(f"{phase.name:<20s} {phase.concurrency_level:>5d} "
              f"{s['tokens_used']:>5d} "
              f"{s['total_calls']:>7d} {s['error_rate_pct']:>5.1f}% "
              f"{s['throughput_tps']:>8.2f} "
              f"{p50} {p95} {p99}")


