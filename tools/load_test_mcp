def _parse_tool_weights(raw: list[str] | None) -> dict[str, float] | None:
    if not raw:
        return None
    weights: dict[str, float] = {}
    for item in raw:
        parts = item.split("=", 1)
        if len(parts) != 2:
            print(f"warning: ignoring weight spec {item!r} (expected tool=weight)")
            continue
        tool, weight_str = parts
        if tool not in DEFAULT_WEIGHTS:
            print(f"warning: ignoring unknown tool {tool!r}")
            continue
        try:
            weights[tool] = float(weight_str)
        except ValueError:
            print(f"warning: ignoring invalid weight {weight_str!r} for {tool}")
    return weights if weights else None


def _read_tokens(token: str | None, token_file: str | None) -> list[str]:
    if token_file:
        with open(token_file) as f:
            tokens = [line.strip() for line in f if line.strip()]
        if not tokens:
            print("error: --token-file is empty", file=sys.stderr)
            sys.exit(1)
        return tokens
    if token:
        return [token]
    print("error: either --token or --token-file is required", file=sys.stderr)
    sys.exit(1)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Load test a RenderDesk MCP server.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    p.add_argument("--url", default="http://localhost:8000/mcp",
                    help="MCP server URL (default: http://localhost:8000/mcp)")
    p.add_argument("--token",
                    help="Bearer token for MCP auth (single token mode)")
    p.add_argument("--token-file",
                    help="File with one Bearer token per line (per-agent token mode)")
    p.add_argument("--concurrency", type=int, default=10,
                    help="Number of concurrent agents (default: 10)")
    p.add_argument("--max-concurrency", type=int, default=50,
                    help="Maximum concurrency for ramp/stress (default: 50)")
    p.add_argument("--duration", type=float, default=60,
                    help="Test duration in seconds (default: 60)")
    p.add_argument("--stress-duration", type=float, default=120,
                    help="Stress phase duration in seconds (default: 120)")
    p.add_argument("--soak-duration", type=float, default=1800,
                    help="Soak phase duration in seconds (default: 1800)")
    p.add_argument("--seed", type=int, default=0,
                    help="Number of seed artifacts to create before testing (default: 0)")
    p.add_argument("--other-email",
                    help="Email of another user for share_artifact testing")
    p.add_argument("--timeout", type=float, default=30.0,
                    help="HTTP request timeout in seconds (default: 30)")
    p.add_argument("--tool-weights", nargs="*", metavar="TOOL=WEIGHT",
                    help="Tool weights (e.g. publish_artifact=10 get_artifact=40)")
    p.add_argument("--phase", choices=["baseline", "ramp", "stress", "soak", "all"],
                    default="all",
                    help="Test phase to run (default: all)")
    p.add_argument("--json", metavar="FILE",
                    help="Write machine-readable summary as JSON to FILE")
    return p


def _normalize_url(raw: str) -> str:
    if not raw.endswith("/mcp"):
        return raw.rstrip("/") + "/mcp"
    return raw


async def main() -> None:
    args = build_parser().parse_args()
    args.url = _normalize_url(args.url)
    tokens = _read_tokens(args.token, args.token_file)

    custom_weights = _parse_tool_weights(args.tool_weights)
    weights: dict[str, float] = custom_weights if custom_weights else dict(DEFAULT_WEIGHTS)

    print(f"Target: {args.url}")
    print(f"Phase: {args.phase}")
    print(f"Tokens: {len(tokens)} unique  |  "
          f"Concurrency: {args.concurrency}  |  "
          f"Max: {args.max_concurrency}")
    print(f"Tool mix: {weights}")
    print()

    state: dict[str, Any] = {
        "artifacts_by_token": defaultdict(list),
        "comments_by_token": defaultdict(list),
        "seeded_artifact_ids": [],
        "other_email": args.other_email,
    }

    if args.seed > 0:
        state = await seed_server(args.url, tokens[0], args.seed, args.timeout, args.other_email)
        print()

    phases: list[PhaseResult] = []

    match args.phase:
        case "baseline":
            phases.append(await run_phase(
                "baseline", args.url, tokens, 1, args.duration, weights, state, args.timeout,
            ))
        case "ramp":
            phases.extend(await run_ramp_phase(
                args.url, tokens, args.max_concurrency, args.duration, weights, state, args.timeout,
            ))
        case "stress":
            phases.append(await run_phase(
                "stress", args.url, tokens, args.concurrency, args.duration, weights, state, args.timeout,
            ))
        case "soak":
            phases.append(await run_phase(
                "soak", args.url, tokens, args.concurrency, args.duration, weights, state, args.timeout,
            ))
        case "all":
            phases.extend(await run_all_phases(
                args.url, tokens, args.max_concurrency,
                args.stress_duration, args.soak_duration,
                weights, state, args.timeout,
            ))

    print()
    print_report(phases)

    if args.json:
        data = {
            "target": args.url,
            "phase": args.phase,
            "tokens_available": len(tokens),
            "tool_mix": weights,
            "phases": [{"name": p.name, "concurrency": p.concurrency_level} | p.summary() for p in phases],
        }
        with open(args.json, "w") as f:
            json.dump(data, f, indent=2)
        print(f"\nJSON summary written to {args.json}")


if __name__ == "__main__":
    asyncio.run(main())
