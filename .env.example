RENDERDESK_DATABASE_PATH=./data/renderdesk.db
RENDERDESK_PUBLIC_BASE_URL=http://localhost:8000
RENDERDESK_TOKEN_EXPIRY_DAYS=90
RENDERDESK_MAX_ARTIFACTS_PER_CONNECTION=200
RENDERDESK_MAX_BYTES_PER_ARTIFACT=2000000
RENDERDESK_MAX_TOTAL_BYTES_PER_CONNECTION=50000000

# Docker-only (read by docker-entrypoint.sh, not the Python app): the
# reverse proxy's IP or CIDR to trust for X-Forwarded-For/-Proto. Leave
# unset to fall back to uvicorn's own default (trust only 127.0.0.1).
# RENDERDESK_TRUSTED_PROXY_IPS=
