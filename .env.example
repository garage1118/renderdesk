RENDERDESK_DATABASE_PATH=./data/renderdesk.db
RENDERDESK_PUBLIC_BASE_URL=http://localhost:8000

# Required, no default. Set once on first boot; the chosen scheme is then
# persisted in the DB and every later restart must match it. To change it
# on purpose later, run `renderdesk set-auth-scheme <scheme>` first, then
# update this to match before restarting. See auth_scheme.py.
RENDERDESK_AUTH_SCHEME=password

# Required only when RENDERDESK_AUTH_SCHEME=oidc. Issuer URL is used both to
# build the redirect_uri and to fetch /.well-known/openid-configuration.
# RENDERDESK_OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# RENDERDESK_OIDC_CLIENT_ID=
# RENDERDESK_OIDC_CLIENT_SECRET=

# Off by default: a first-time OIDC login only ever creates a new account
# if this is explicitly set to true. Otherwise, accounts stay CLI-provisioned
# only (`renderdesk create-user`), and an unrecognized IdP identity is
# rejected rather than silently signing someone up.
# RENDERDESK_OIDC_ALLOW_SIGNUP=false

RENDERDESK_TOKEN_EXPIRY_DAYS=90
RENDERDESK_MAX_ARTIFACTS_PER_CONNECTION=200
RENDERDESK_MAX_BYTES_PER_ARTIFACT=2000000
RENDERDESK_MAX_TOTAL_BYTES_PER_CONNECTION=50000000

# Docker-only (read by docker-entrypoint.sh, not the Python app): the
# reverse proxy's IP or CIDR to trust for X-Forwarded-For/-Proto. Leave
# unset to fall back to uvicorn's own default (trust only 127.0.0.1).
# RENDERDESK_TRUSTED_PROXY_IPS=
